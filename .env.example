# ============================================================
# NexHire AI — Root Environment Variables
# Copy this to .env and fill in production values
# ============================================================

# --- Backend ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/nexhire
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-this-to-a-secure-random-string
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=10

# --- AI Service ---
DEBUG=true
SPACY_MODEL=en_core_web_sm
EMBEDDING_MODEL=all-MiniLM-L6-v2

