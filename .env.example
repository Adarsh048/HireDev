# ============================================================
# DevLaunch — Environment Variables Template
# Copy this file to .env before starting the services
# Never commit real credentials or .env files to source control!
# ============================================================

# --- Backend Configuration ---
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/devlaunch
REDIS_URL=redis://localhost:6379

# Generate strong 64-character random strings for production JWT secrets:
# e.g., openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_strong_production_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_strong_production_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=10

# --- AI Service Configuration ---
DEBUG=false
HOST=0.0.0.0
PORT=8000
SPACY_MODEL=en_core_web_sm
EMBEDDING_MODEL=all-MiniLM-L6-v2
BACKEND_URL=http://localhost:5000

# --- Frontend Configuration ---
# Leave empty for same-origin or local proxy, or set to your API domain in production
VITE_API_URL=
